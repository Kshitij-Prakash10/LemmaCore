.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.claude/settings.local.json

# raw data and generated outputs are not committed
data/raw/*
!data/raw/.gitkeep
outputs/

# hand-off zips for moving the skeleton between laptops
handoff/*
!handoff/.gitkeep

# large generated training files stay local; small processed files are committed
data/processed/*.parquet
data/processed/scenarios.csv
